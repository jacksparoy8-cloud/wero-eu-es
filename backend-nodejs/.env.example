# Configuration Node.js - WERO Payment (Template)
NODE_ENV=development
PORT=3000

# Database MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=wero
DB_USER=wero_user
DB_PASSWORD=secret
DB_DIALECT=mysql

# Application
APP_NAME=WERO
APP_URL=http://localhost:8002
APP_DEBUG=true

# Logging
LOG_LEVEL=debug

# Session
SESSION_SECRET=your-secret-key-change-this
SESSION_TIMEOUT=3600

# Email (optional for future features)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Security
CORS_ORIGIN=http://localhost:8002
CORS_CREDENTIALS=true

# API Keys (optional)
API_KEY_PAYMENT=
API_KEY_VERIFICATION=

# Feature Flags
ENABLE_PAYMENT_LOG=true
ENABLE_VERIFICATION_LOG=true

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
