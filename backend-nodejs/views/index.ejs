<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WERO – Paiement Instantané & Sécurisé</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #FFF275;
      --primary-dark: #FFF0A0;
      --black: #0A0E27;
      --white: #FFFFFF;
      --gray-50: #F9FAFB;
      --gray-100: #F3F4F6;
      --gray-200: #E5E7EB;
      --gray-300: #D1D5DB;
      --gray-400: #9CA3AF;
      --gray-600: #4B5563;
      --accent-green: #10B981;
      --accent-blue: #3B82F6;
      --shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.2);
      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(135deg, #FFF275 0%, #FFFFB3 50%, #FFFF99 100%);
      color: var(--black);
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* HEADER */
    header {
      background: rgba(255, 242, 117, 0.95);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
      padding: 12px 0;
    }

    .header-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .logo {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: -2px;
      color: var(--black);
      animation: logoGlow 3s ease-in-out infinite;
    }

    @keyframes logoGlow {
      0%, 100% { filter: drop-shadow(0 0 0px rgba(0,0,0,0.1)); }
      50% { filter: drop-shadow(0 0 8px rgba(0,0,0,0.2)); }
    }

    .desktop-nav {
      display: flex;
      gap: 10px;
    }

    .desktop-nav a {
      text-decoration: none;
      color: var(--black);
      font-weight: 600;
      font-size: 15px;
      padding: 10px 18px;
      border-radius: 12px;
      transition: var(--transition);
    }

    .desktop-nav a:hover {
      background: rgba(0, 0, 0, 0.08);
    }

    .mobile-menu-btn {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      width: 32px;
      height: 24px;
      position: relative;
      z-index: 1001;
    }

    .mobile-menu-btn span {
      display: block;
      width: 100%;
      height: 2.5px;
      background: var(--black);
      border-radius: 2px;
      transition: var(--transition);
      position: absolute;
    }

    .mobile-menu-btn span:nth-child(1) { top: 2px; }
    .mobile-menu-btn span:nth-child(2) { top: 11px; }
    .mobile-menu-btn span:nth-child(3) { top: 20px; }

    .mobile-menu-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(3px);
      z-index: 999;
      opacity: 0;
    }

    .mobile-nav {
      display: none;
      position: fixed;
      top: 0;
      right: -100%;
      width: 85%;
      max-width: 400px;
      height: 100%;
      background: #FFF275;
      z-index: 1000;
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.2);
      transition: right 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      flex-direction: column;
    }

    .mobile-nav.active {
      right: 0;
    }

    .mobile-nav-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .mobile-menu-close {
      background: none;
      border: none;
      font-size: 24px;
      cursor: pointer;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      transition: var(--transition);
    }

    .mobile-menu-close:hover {
      background: rgba(0, 0, 0, 0.08);
    }

    .mobile-nav-links {
      flex: 1;
      padding: 20px 0;
    }

    .mobile-nav-links a {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 16px 24px;
      text-decoration: none;
      color: var(--black);
      font-weight: 600;
      font-size: 16px;
      transition: var(--transition);
      border-left: 4px solid transparent;
    }

    .mobile-nav-links a:hover {
      background: rgba(0, 0, 0, 0.08);
      border-left-color: var(--black);
    }

    .mobile-nav-footer {
      padding: 20px;
      text-align: center;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      color: var(--black);
      font-weight: 600;
      font-size: 14px;
    }

    /* HERO SECTION */
    .hero {
      padding: 80px 0 60px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .hero h1 {
      font-size: 64px;
      font-weight: 900;
      margin-bottom: 20px;
      color: var(--black);
      letter-spacing: -2px;
      line-height: 1.1;
      animation: slideInDown 1s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .hero p {
      font-size: 20px;
      color: rgba(0, 0, 0, 0.7);
      max-width: 600px;
      margin: 0 auto 50px;
      animation: slideInUp 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s backwards;
      font-weight: 500;
    }

    @keyframes slideInDown {
      from {
        opacity: 0;
        transform: translateY(-50px) rotateX(10deg);
      }
      to {
        opacity: 1;
        transform: translateY(0) rotateX(0deg);
      }
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(50px) rotateX(-10deg);
      }
      to {
        opacity: 1;
        transform: translateY(0) rotateX(0deg);
      }
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-50px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(50px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.8);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* NOTIFICATION */
    .notification {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      padding: 16px 32px;
      border-radius: 50px;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-weight: 600;
      color: var(--black);
      margin: 30px auto;
      box-shadow: var(--shadow-xl);
      animation: scaleIn 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s backwards;
      border: 2px solid rgba(0, 0, 0, 0.05);
    }

    .notification i {
      font-size: 20px;
      color: #FF6B00;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    /* BANNER */
    .banner-section {
      max-width: 550px;
      margin: 40px auto;
      animation: slideInUp 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.45s backwards;
    }

    .banner-image {
      width: 100%;
      height: auto;
      border-radius: 24px;
      box-shadow: var(--shadow-xl);
      transition: var(--transition);
      display: block;
    }

    .banner-image:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
    }

    /* BUTTONS */
    .hero-buttons {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 420px;
      margin: 40px auto 60px;
    }

    .btn-primary, .btn-secondary {
      padding: 18px 40px;
      border-radius: 16px;
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      text-align: center;
      transition: var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      position: relative;
      overflow: hidden;
      border: 2px solid transparent;
      cursor: pointer;
      letter-spacing: 0.5px;
    }

    .btn-primary {
      background: linear-gradient(135deg, #000 0%, #1a1a1a 100%);
      color: #FFF275;
      box-shadow: var(--shadow-xl);
      animation: slideInUp 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s backwards;
    }

    .btn-primary:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .btn-secondary {
      background: transparent;
      color: var(--black);
      border-color: var(--black);
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      animation: slideInUp 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.75s backwards;
    }

    .btn-secondary:hover {
      transform: translateY(-4px);
      background: rgba(0, 0, 0, 0.05);
      box-shadow: var(--shadow-xl);
    }

    /* INFO SECTIONS - PAIEMENT EN LIGNE */
    .info-section {
      margin: 80px 0;
    }

    .section-title {
      text-align: center;
      font-size: 36px;
      font-weight: 900;
      margin-bottom: 50px;
      color: var(--black);
      animation: slideInDown 1s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 30px;
      margin-bottom: 60px;
    }

    .info-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 40px 30px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      transition: var(--transition);
      border: 2px solid rgba(0, 0, 0, 0.05);
      animation: slideInUp 1s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .info-card:nth-child(1) { animation-delay: 0.2s; }
    .info-card:nth-child(2) { animation-delay: 0.4s; }
    .info-card:nth-child(3) { animation-delay: 0.6s; }

    .info-card:hover {
      transform: translateY(-10px);
      box-shadow: var(--shadow-xl);
    }

    .info-card i {
      font-size: 48px;
      color: var(--accent-green);
      margin-bottom: 20px;
      display: inline-block;
      animation: pulse 2s infinite;
    }

    .info-card h3 {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 15px;
      color: var(--black);
    }

    .info-card p {
      font-size: 15px;
      color: var(--gray-600);
      line-height: 1.6;
    }

    /* FEATURES SECTION */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
      margin-bottom: 60px;
    }

    .feature-item {
      background: rgba(255, 255, 255, 0.95);
      padding: 30px;
      border-radius: 16px;
      display: flex;
      gap: 20px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      transition: var(--transition);
      border-left: 4px solid var(--accent-green);
      animation: slideInLeft 1s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .feature-item:nth-child(1) { animation-delay: 0.1s; }
    .feature-item:nth-child(2) { animation-delay: 0.3s; }
    .feature-item:nth-child(3) { animation-delay: 0.5s; }
    .feature-item:nth-child(4) { animation-delay: 0.7s; }

    .feature-item:hover {
      transform: translateX(8px);
      box-shadow: var(--shadow-xl);
    }

    .feature-icon {
      flex-shrink: 0;
      width: 50px;
      height: 50px;
      background: rgba(16, 185, 129, 0.1);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: var(--accent-green);
    }

    .feature-content h4 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--black);
    }

    .feature-content p {
      font-size: 14px;
      color: var(--gray-600);
      line-height: 1.5;
    }

    /* FOOTER */
    footer {
      background: var(--black);
      color: var(--white);
      padding: 80px 0 40px;
      margin-top: 60px;
      width: 100%;
      border-top: 2px solid rgba(255, 242, 117, 0.3);
    }

    .footer-content {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 60px;
      margin-bottom: 50px;
      width: 100%;
    }

    .footer-section {
      flex: 1;
      min-width: 250px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-section h3 {
      font-size: 20px;
      margin-bottom: 20px;
      color: #FFD500;
      font-weight: 700;
    }

    .footer-section p {
      margin-bottom: 15px;
      opacity: 0.8;
      font-size: 14px;
    }

    .footer-section a {
      display: block;
      color: var(--white);
      text-decoration: none;
      margin-bottom: 10px;
      opacity: 0.7;
      transition: var(--transition);
      font-size: 14px;
    }

    .footer-section a:hover {
      opacity: 1;
      color: #FFD500;
    }

    .footer-bottom {
      text-align: center;
      padding-top: 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      opacity: 0.6;
      font-size: 14px;
    }

    /* LOADER */
    .loader-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #FFF275 0%, #FFFFB3 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s, visibility 0.3s;
    }

    .loader-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .loader-content {
      text-align: center;
      max-width: 400px;
    }

    .logo-animation {
      position: relative;
      width: 120px;
      height: 120px;
      margin: 0 auto 30px;
    }

    .logo-circle {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      border: 3px solid transparent;
    }

    .logo-circle:nth-child(1) {
      width: 120px;
      height: 120px;
      border-top-color: #000;
      animation: spin 2s linear infinite;
    }

    .logo-circle:nth-child(2) {
      width: 90px;
      height: 90px;
      border-top-color: #FF6B00;
      animation: spin 1.5s linear infinite reverse;
    }

    .logo-circle:nth-child(3) {
      width: 60px;
      height: 60px;
      border-top-color: #000;
      animation: spin 1s linear infinite;
    }

    .logo-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 36px;
      font-weight: 900;
      color: #000;
      animation: bounce 1s infinite;
    }

    @keyframes spin {
      0% { transform: translate(-50%, -50%) rotate(0deg); }
      100% { transform: translate(-50%, -50%) rotate(360deg); }
    }

    @keyframes bounce {
      0%, 100% { transform: translate(-50%, -50%) scale(1); }
      50% { transform: translate(-50%, -50%) scale(1.05); }
    }

    .loader-text {
      font-size: 20px;
      font-weight: 700;
      color: var(--black);
      margin-top: 20px;
    }

    .loader-subtext {
      color: rgba(0, 0, 0, 0.6);
      margin-top: 10px;
      font-size: 14px;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .desktop-nav { display: none; }
      .mobile-menu-btn { display: block; }
      .mobile-nav { display: flex; }
      
      .logo { font-size: 28px; }
      .hero h1 { font-size: 44px; }
      .hero p { font-size: 18px; }
      .section-title { font-size: 28px; }
      .btn-primary, .btn-secondary { padding: 16px 32px; font-size: 15px; }
      
      .info-grid {
        grid-template-columns: 1fr;
      }
      
      .features-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .hero h1 { font-size: 32px; }
      .hero p { font-size: 16px; }
      .section-title { font-size: 24px; }
      .btn-primary, .btn-secondary { padding: 14px 24px; font-size: 14px; }
      .info-card { padding: 30px 20px; }
      .feature-item { padding: 20px; gap: 15px; }
    }
  </style>
</head>
<body>

  <!-- LOADER -->
  <div class="loader-overlay" id="pageLoader">
    <div class="loader-content">
      <div class="logo-animation">
        <div class="logo-circle"></div>
        <div class="logo-circle"></div>
        <div class="logo-circle"></div>
        <div class="logo-text">WERO</div>
      </div>
      <div class="loader-text">Chargement</div>
      <div class="loader-subtext">Préparation de votre expérience de paiement</div>
    </div>
  </div>

  <!-- HEADER -->
  <header>
    <div class="container header-container">
      <div class="logo">WERO</div>
      
      <nav class="desktop-nav">
        <a href="/">Accueil</a>
      </nav>
      
      <button class="mobile-menu-btn" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <div class="mobile-menu-overlay"></div>
      
      <nav class="mobile-nav">
        <div class="mobile-nav-header">
          <div class="logo">WERO</div>
          <button class="mobile-menu-close"><i class="fas fa-times"></i></button>
        </div>
        <div class="mobile-nav-links">
          <a href="/">Accueil</a>
        </div>
        <div class="mobile-nav-footer">
          <p>Paiement instantané sécurisé</p>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="container">
        <h1>WERO</h1>
        <p>Le paiement instantané révolutionnaire pour tous</p>
        
        <div class="notification">
          <i class="fas fa-bolt"></i>
          Transférez de l'argent en moins de 10 secondes
        </div>
        
        <div class="banner-section">
          <img src="https://epicompany.eu/storage/images/Wero-Pay-post.png" alt="WERO" class="banner-image">
        </div>
        
        <div class="hero-buttons">
          <a href="/accords" class="btn-primary">
            <i class="fas fa-play-circle"></i>
            ACTIVEZ MON WERO MAINTENANT
          </a>
          <a href="/accords" class="btn-secondary">
            <i class="fas fa-hand-holding-usd"></i>
            RÉCUPÉRER MON ARGENT
          </a>
        </div>
      </div>
    </section>

    <!-- SECURITY & TRUST -->
    <section class="info-section">
      <div class="container">
        <h2 class="section-title">🔒 Sécurité & Confiance</h2>
        <div class="info-grid">
          <div class="info-card">
            <i class="fas fa-shield-alt"></i>
            <h3>Cryptage 256-bit</h3>
            <p>Protection SSL/TLS maximale pour vos transactions</p>
          </div>
          <div class="info-card">
            <i class="fas fa-lock"></i>
            <h3>Données Sécurisées</h3>
            <p>Conformité PCI DSS et normes bancaires internationales</p>
          </div>
          <div class="info-card">
            <i class="fas fa-user-check"></i>
            <h3>Authentification 2FA</h3>
            <p>Vérification en deux étapes pour chaque transaction</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="info-section">
      <div class="container">
        <h2 class="section-title">✨ Nos Avantages</h2>
        <div class="features-grid">
          <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-zap"></i></div>
            <div class="feature-content">
              <h4>Transferts Instantanés</h4>
              <p>Votre argent arrive en moins de 10 secondes</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-euro-sign"></i></div>
            <div class="feature-content">
              <h4>Frais Ultra Bas</h4>
              <p>0.5% seulement pour les transferts de moins de 100€</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-globe"></i></div>
            <div class="feature-content">
              <h4>Envois Internationaux</h4>
              <p>Vers plus de 150 pays avec taux avantageux</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-24-7"></i></div>
            <div class="feature-content">
              <h4>Support 24h/24</h4>
              <p>Notre équipe disponible pour répondre à vos questions</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PAYMENT METHODS -->
    <section class="info-section">
      <div class="container">
        <h2 class="section-title">💳 Moyens de Paiement</h2>
        <div class="info-grid">
          <div class="info-card">
